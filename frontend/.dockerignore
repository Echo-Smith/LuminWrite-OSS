# ─── Frontend .dockerignore ─────────────────────────────
# Minimizes build context when running: docker build ./frontend

# Dependencies (installed in Docker build stage)
node_modules/

# Build output (rebuilt in Docker)
dist/
.tsbuildinfo

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Git
.git
.gitignore

# Logs
*.log
