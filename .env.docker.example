# ─── Writing Agent V2 — Docker Environment ───
# Copy to .env.docker and fill in your API keys

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=120s

# Database (auto-configured by docker-compose, override here if needed)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/writing_agent_v2?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# PostgreSQL password (used by both postgres and backend services)
POSTGRES_PASSWORD=postgres

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRY=24h

# Admin
ADMIN_TOKEN=change-this-in-production
API_KEY_ENCRYPTION_KEY=change-this-encryption-key

# DeepSeek LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120s
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.7

# Dashscope (Embedding)
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=text-embedding-v3
DASHSCOPE_DIMENSION=1024

# IMA Knowledge Base
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=your-ima-client-id
IMA_API_KEY=your-ima-api-key
IMA_KB_ID=your-ima-kb-id
IMA_TIMEOUT=15s

# Zhihu
ZHIHU_ENABLED=false
ZHIHU_BASE_URL=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=
ZHIHU_TIMEOUT=15s

# Tavily Search
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_TIMEOUT=20s

# WebAuthn / Passkeys
# Local dev (Vite):  http://localhost:5173
# Docker (Nginx):    http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=笔润智谈
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
