# ─── Writing Agent V2 — Docker Environment ───
# Copy to .env.docker and fill in your API keys

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=120s

# Database (auto-configured by docker-compose, override here if needed)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/writing_agent_v2?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# PostgreSQL password (used by both postgres and backend services)
POSTGRES_PASSWORD=postgres

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRY=24h

# Admin
ADMIN_TOKEN=change-this-in-production
API_KEY_ENCRYPTION_KEY=change-this-encryption-key

# DeepSeek LLM (Fallback — LLM keys are now managed in Admin > 模型配置)
# These values are used only when the database is unavailable or no model config exists.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120s
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_TEMPERATURE=0.7

# Dashscope / 阿里云百炼 MaaS (Embedding) — OpenAI 兼容接口
# 支持任何兼容 /v1/embeddings 的提供商 (DashScope MaaS, SiliconFlow, Ollama 等)
# DashScope 默认: https://dashscope.aliyuncs.com/compatible-mode/v1
# SiliconFlow:    https://api.siliconflow.cn/v1
# Ollama:         http://localhost:11434/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=text-embedding-v3
DASHSCOPE_DIMENSION=1024

# IMA Knowledge Base
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=your-ima-client-id
IMA_API_KEY=your-ima-api-key
IMA_KB_ID=your-ima-kb-id
IMA_TIMEOUT=15s

# Zhihu
ZHIHU_ENABLED=false
ZHIHU_BASE_URL=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=
ZHIHU_TIMEOUT=15s

# Tavily Search
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_TIMEOUT=20s

# WebAuthn / Passkeys
# Local dev (Vite):  http://localhost:5173
# Docker (Nginx):    http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=笔润智谈
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# Tencent News (热搜)
TENCENT_ENABLED=true
TENCENT_BASE_URL=https://r.inews.qq.com
TENCENT_TIMEOUT=15s

# Tencent News CLI (新闻搜索 + 较真事实核查)
# 安装: curl -fsSL https://mat1.gtimg.com/qqcdn/qqnews/cli/hub/tencent-news/setup.sh | sh
# API Key 获取: https://news.qq.com/exchange?scene=appkey
TENCENT_NEWS_CLI_PATH=
TENCENT_NEWS_API_KEY=

# 较真事实核查 (使用 tencent-news-cli jiaozhen 子命令)
JIAOZHEN_ENABLED=true
JIAOZHEN_CLI_PATH=
JIAOZHEN_API_KEY=
JIAOZHEN_TIMEOUT=30s
JIAOZHEN_MAX_CLAIMS=2

# Bing China Search (网页解析，无需 API Key，国内可用)
BING_ENABLED=true
BING_BASE_URL=https://cn.bing.com
BING_TIMEOUT=15s

# Hot Topics Auto-Fetch Interval
HOT_TOPICS_FETCH_INTERVAL=10m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Agent Exit Mechanisms
# Global execution timeout per agent run
AGENT_TIMEOUT=5m
# Token budget per execution (0 = unlimited)
AGENT_MAX_TOKENS=300000
# Max review→fix loop iterations
AGENT_MAX_FIX_ATTEMPTS=2
# Max concurrent agent executions globally
AGENT_MAX_CONCURRENT=10
# Max concurrent per user
AGENT_MAX_CONCURRENT_PER_USER=1
# User confirm (await_input) timeout
AGENT_CONFIRM_TIMEOUT=5m
# Consecutive LLM failures before circuit breaker trips
AGENT_CIRCUIT_BREAKER_FAILS=3
