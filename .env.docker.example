# ─── Writing Agent V2 — Docker Environment Template ─────
# Copy to .env.docker and fill in your API keys:
#   cp .env.docker.example .env.docker

# ── Server ──────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=120s

# ── Database (auto-configured by docker-compose) ───────
DATABASE_URL=postgres://postgres:postgres@postgres:5432/writing_agent_v2?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
POSTGRES_PASSWORD=postgres

# ── Ports (override in .env.docker if needed) ──────────
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_EXPIRY=24h

# ── Admin ───────────────────────────────────────────────
ADMIN_TOKEN=change-this-in-production
API_KEY_ENCRYPTION_KEY=change-this-32-byte-key

# ── DeepSeek LLM (Fallback — keys managed in Admin > 模型配置) ──
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120s
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_TEMPERATURE=0.7
# A/B test ratio for Responses API (0.0=off, 0.5=50/50, 1.0=full Responses API)
DEEPSEEK_RESPONSES_API_RATIO=0

# ── Dashscope / 阿里云百炼 (Embedding) ─────────────────
# https://bailian.console.aliyun.com/
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=text-embedding-v3
DASHSCOPE_DIMENSION=1024

# ── Zhihu ───────────────────────────────────────────────
ZHIHU_ENABLED=true
ZHIHU_BASE_URL=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=your-zhihu-secret
ZHIHU_TIMEOUT=15s

# ── Tavily Search ───────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_TIMEOUT=20s

# ── WebAuthn / Passkeys ─────────────────────────────────
# 生产环境示例: https://luminbuddy2.ericdocmic.top/
WEBAUTHN_RP_ID=luminbuddy2.ericdocmic.top
WEBAUTHN_RP_NAME=笔润智谈
WEBAUTHN_RP_ORIGIN=https://luminbuddy2.ericdocmic.top

# ── Web Push (VAPID) ────────────────────────────────────
# 生成密钥：npx web-push generate-vapid-keys
# 或使用在线工具：https://vapidkeys.com/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:luminbuddy@ericdocmic.top

# ── Tencent News (热搜) ────────────────────────────────
TENCENT_ENABLED=true
TENCENT_BASE_URL=https://r.inews.qq.com
TENCENT_TIMEOUT=15s

# ── Tencent News CLI (新闻搜索 + 较真事实核查) ────────
# https://news.qq.com/exchange?scene=appkey
# API Key 可通过 Admin > MCP Keys 页面配置，覆盖此环境变量
TENCENT_NEWS_CLI_PATH=
TENCENT_NEWS_API_KEY=your-tencent-news-api-key

# ── 较真事实核查 ────────────────────────────────────────
# API Key 可通过 Admin > MCP Keys 页面配置，覆盖此环境变量
JIAOZHEN_ENABLED=true
JIAOZHEN_CLI_PATH=
JIAOZHEN_API_KEY=your-jiaozhen-api-key
JIAOZHEN_TIMEOUT=60s
JIAOZHEN_MAX_CLAIMS=2

# ── Weibo (热搜) ───────────────────────────────────────
WEIBO_ENABLED=true
WEIBO_BASE_URL=https://weibo.com/ajax
WEIBO_TIMEOUT=15s

# ── Extra Hot Search (百度/知乎/抖音/B站/头条/快手) ────
EXTRA_HOT_ENABLED=true
EXTRA_HOT_BASE_URL=https://api.vvhan.com/api/hotlist
EXTRA_HOT_TIMEOUT=15s

# ── Bing China Search (网页解析) ───────────────────────
BING_ENABLED=true
BING_BASE_URL=https://cn.bing.com
BING_TIMEOUT=15s

# ── AnySearch (AI搜索) ─────────────────────────────────
# https://www.anysearch.com/
ANYSEARCH_API_KEY=your-anysearch-api-key
ANYSEARCH_ENDPOINT=https://api.anysearch.com/v1/search
ANYSEARCH_TIMEOUT=15s

# ─── Knowledge Base (内化知识库，原生运行在 PostgreSQL 上) ────
# BM25 (paradedb) + Dense (pgvector) + GraphRAG
# docreader TCP 地址（由 docker-compose 自动配置，精简版 ~150MB 替代旧 5.53GB 镜像）
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=tcp

# 知识库分块配置
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=50

# 混合检索权重（BM25 + Dense + GraphRAG）
KB_BM25_WEIGHT=0.3
KB_DENSE_WEIGHT=0.5
KB_GRAPH_WEIGHT=0.2

# LLM 配置 (用于 GraphRAG 实体抽取，复用 DeepSeek API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-v4-flash

# ── Hot Topics ──────────────────────────────────────────
HOT_TOPICS_FETCH_INTERVAL=10m

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Agent ───────────────────────────────────────────────
# harness:  架构 C — Harness-LLM 单层持续会话（推荐）
# pipeline: 固定流程 — 无外层 LLM 编排
AGENT_MODE=harness
AGENT_TIMEOUT=5m
AGENT_MAX_TOKENS=300000
AGENT_MAX_FIX_ATTEMPTS=2
AGENT_MAX_CONCURRENT=10
AGENT_MAX_CONCURRENT_PER_USER=1
AGENT_CONFIRM_TIMEOUT=5m
AGENT_CIRCUIT_BREAKER_FAILS=3
# How long to keep paused sessions in memory after client disconnect (default 2m)
# If the user reconnects and resumes within this window, execution continues from the pause point
AGENT_PAUSED_SESSION_TTL=2m
