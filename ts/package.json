{
  "name": "luminwrite-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "pnpm -r --sort test",
    "typecheck": "pnpm -r --sort typecheck",
    "lint": "biome check .",
    "demo": "pnpm --filter @luminwrite/cli demo",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
