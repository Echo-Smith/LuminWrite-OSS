# ─── Backend .dockerignore ──────────────────────────────
# Minimizes build context when running: docker build ./backend

# Build artifacts
bin/
*.exe
*.test

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
._*
Thumbs.db

# Environment (never leak secrets into images)
.env
.env.docker
.env.docker.example
# Keep .env.example — it's copied into the image as a template
!.env.example

# Git
.git
.gitignore

# Docs
docs/

# Logs
*.log
logs/
tmp/
