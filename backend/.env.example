# Writing Agent V2 — Environment Variables

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=120s

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/writing_agent_v2?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis (optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRY=24h

# Admin
ADMIN_TOKEN=change-this-in-production

# DeepSeek LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-deepseek-api-key-here
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120s
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.7

# Dashscope (Embedding)
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=text-embedding-v3
DASHSCOPE_DIMENSION=1024

# IMA Knowledge Base
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KB_ID=
IMA_TIMEOUT=15s

# Zhihu
ZHIHU_ENABLED=false
ZHIHU_BASE_URL=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=
ZHIHU_TIMEOUT=15s

# Tavily Search
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_TIMEOUT=20s

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=笔润智谈
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
