{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminbuddy.dev/schemas/lcp/v1/run-event.schema.json",
  "title": "LCP v1 RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "occurred_at",
    "node_id",
    "attempt",
    "idempotency_key",
    "causation_event_id",
    "entity",
    "payload",
    "checksum"
  ],
  "properties": {
    "schema_version": {
      "const": "lcp/1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "run.planned",
        "run.started",
        "run.paused",
        "run.resumed",
        "run.cancelled",
        "run.completed",
        "run.failed",
        "node.started",
        "node.completed",
        "node.failed",
        "artifact.created",
        "quality.updated",
        "snapshot.created"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "node_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "causation_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "run",
            "node",
            "artifact",
            "document_version",
            "quality_report",
            "snapshot"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "node.started",
              "node.completed",
              "node.failed",
              "artifact.created"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
