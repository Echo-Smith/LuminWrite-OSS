              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "code"
            },
            "text": {
              "type": "string"
            },
            "attrs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "language": {
