{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminbuddy.dev/schemas/lcp/v1/document-ast.schema.json",
  "title": "LCP v1 Document Version AST",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "version_id", "base_version_id", "content_hash", "version_hash", "root"],
  "properties": {
    "schema_version": { "const": "lcp/1.0" },
    "document_id": { "type": "string", "pattern": "^doc_[A-Za-z0-9_-]+$" },
    "version_id": { "type": "string", "pattern": "^ver_[A-Za-z0-9_-]+$" },
    "base_version_id": {
      "anyOf": [
        { "type": "string", "pattern": "^ver_[A-Za-z0-9_-]+$" },
        { "type": "null" }
      ]
    },
    "content_hash": { "$ref": "#/$defs/hash" },
    "version_hash": { "$ref": "#/$defs/hash" },
    "root": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "document" } } }
      ]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["user", "model", "system"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "attrs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "children", "origin", "content_hash"],
      "properties": {
        "block_id": { "type": "string", "pattern": "^blk_[A-Za-z0-9_-]+$" },
        "type": {
          "enum": ["document", "section", "paragraph", "text", "strong", "emphasis", "link", "citation", "ordered_list", "unordered_list", "list_item", "blockquote", "code_block", "table", "table_row", "table_cell"]
        },
        "attrs": { "$ref": "#/$defs/attrs" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "text": { "type": "string" },
        "destination": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "origin": { "$ref": "#/$defs/origin" },
        "content_hash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "enum": ["document", "section", "paragraph", "ordered_list", "unordered_list", "list_item", "blockquote", "code_block", "table", "table_row", "table_cell"] }
            }
          },
          "then": { "required": ["block_id"], "properties": { "block_id": true } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["text"],
            "properties": { "text": { "type": "string", "minLength": 1 }, "children": { "type": "array", "maxItems": 0 } }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "citation" } } },
          "then": { "required": ["source_id"], "properties": { "source_id": true, "children": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "link" } } },
          "then": { "required": ["destination"], "properties": { "destination": true, "children": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "enum": ["section", "paragraph", "strong", "emphasis", "ordered_list", "unordered_list", "list_item", "blockquote", "table", "table_row", "table_cell"] }
            }
          },
          "then": { "properties": { "children": { "type": "array", "minItems": 1 } } }
        }
      ]
    }
  }
}
