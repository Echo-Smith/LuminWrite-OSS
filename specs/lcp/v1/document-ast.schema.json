{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminbuddy.dev/schemas/lcp/v1/document-ast.schema.json",
  "title": "LCP v1 Document AST",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "version_id",
    "base_version_id",
    "content_hash",
    "root"
  ],
  "properties": {
    "schema_version": {
      "const": "lcp/1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]+$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^ver_[A-Za-z0-9_-]+$"
    },
    "base_version_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ver_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root": {
      "$ref": "#/$defs/documentNode"
    }
  },
  "$defs": {
    "documentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "type",
        "attrs",
        "children"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^blk_[A-Za-z0-9_-]+$"
        },
        "type": {
          "const": "document"
        },
        "attrs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "children": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "section"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "paragraph"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "list"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "list_item"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "quote"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_id",
            "type",
            "attrs",
            "children"
          ],
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^blk_[A-Za-z0-9_-]+$"
            },
            "type": {
              "const": "table"
            },
            "attrs": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
